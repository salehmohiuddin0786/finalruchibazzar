# ==============================================================
# RUCHI BAZAAR BACKEND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================
# Copy this file to .env and provide your deployment values.
# NEVER commit .env to version control.
# ==============================================================

# Application Port (Default: 7000)
PORT=7000

# Environment Mode: development | staging | production
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ruchi_bazaar
DB_USER=root
DB_PASSWORD=

# JWT Authentication Secret (MUST be at least 32 random characters in production)
JWT_SECRET=replace_with_a_long_random_jwt_secret_in_production

# Optional Cloudinary Configuration (for remote media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional Google reCAPTCHA Verification
RECAPTCHA_SECRET_KEY=

# Firebase Web API Key (Used for verifying Firebase ID tokens from Google Sign-In)
FIREBASE_WEB_API_KEY=

# SuperAdmin Security Signup Code (Required to register SuperAdmin accounts)
MAINADMIN_SIGNUP_CODE=
